# DocVault Test Environment Configuration
# These are the QA service addresses for host-local test execution

# PostgreSQL - port 5433 for host-local tests
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend123
POSTGRES_DB=doc_vault_test
POSTGRES_SSL=disable

# MinIO/S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
BUCKET_PREFIX=test-doc-vault

# Logging
LOG_LEVEL=INFO
